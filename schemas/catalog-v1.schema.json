{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "catalogVersion": {
      "const": 1
    },
    "supportedAssetTypes": {
      "const": []
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "name": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 32,
            "required": [
              "en"
            ],
            "propertyNames": {
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "breeds",
                "toyz",
                "playscenes",
                "skins",
                "music",
                "clothes",
                "textures",
                "sounds",
                "hosts",
                "translations",
                "themes",
                "other"
              ]
            },
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true
          },
          "record": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "name",
          "categories",
          "record"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4096,
      "uniqueItems": true
    }
  },
  "required": [
    "catalogVersion",
    "supportedAssetTypes",
    "projects"
  ],
  "additionalProperties": false
}
