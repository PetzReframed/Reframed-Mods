{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "expandedBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 268435456
    },
    "manifestSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "installable": {
      "const": false
    },
    "validation": {
      "enum": [
        "structure-only",
        "engine-content"
      ]
    },
    "unsupportedReason": {
      "enum": [
        "No runtime asset adapters are released.",
        "Content validated for one pinned engine. Catalog publication has not been approved."
      ]
    },
    "engineValidation": {
      "type": "object",
      "properties": {
        "receiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "engineCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "engineContractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validatorContractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "receiptSha256",
        "engineCommit",
        "engineContractSha256",
        "validatorContractSha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "package",
    "sha256",
    "bytes",
    "expandedBytes",
    "manifestSha256",
    "sourceCommit",
    "installable",
    "validation",
    "unsupportedReason"
  ],
  "additionalProperties": false
}
