{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "required": [
            "en"
          ],
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "description": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "required": [
            "en"
          ],
          "propertyNames": {
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^https://"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "breeds",
              "toyz",
              "playscenes",
              "skins",
              "music",
              "clothes",
              "textures",
              "sounds",
              "hosts",
              "translations",
              "themes",
              "other"
            ]
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "links": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "homepage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "issues": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "authors",
        "categories",
        "license"
      ],
      "additionalProperties": false
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "expandedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "manifestSha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceCommit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[0-9a-f]{40}$"
          },
          "installable": {
            "const": false
          },
          "validation": {
            "const": "structure-only"
          },
          "unsupportedReason": {
            "const": "No runtime asset adapters are released."
          }
        },
        "required": [
          "id",
          "version",
          "package",
          "sha256",
          "bytes",
          "expandedBytes",
          "manifestSha256",
          "sourceCommit",
          "installable",
          "validation",
          "unsupportedReason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    }
  },
  "required": [
    "project",
    "releases"
  ],
  "additionalProperties": false
}
